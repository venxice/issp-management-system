<?php

namespace App\Controllers\IctPlanner;

use App\Controllers\BaseController;
use App\Models\ISspRecordModel;
use App\Models\ResourceRequirementModel;
use App\Models\AgencyInformationModel;
use Dompdf\Dompdf;
use Dompdf\Options;

class ConsolidationController extends BaseController
{
    protected $isspRecordModel;
    protected $resourceRequirementModel;
    protected $agencyInformationModel;

    public function __construct()
    {
        $this->isspRecordModel = new ISspRecordModel();
        $this->resourceRequirementModel = new ResourceRequirementModel();
        $this->agencyInformationModel = new AgencyInformationModel();
    }

    /**
     * ============================================================
     * CONSOLIDATION INDEX
     * ============================================================
     */
  public function index()
{
    $statusFilter = trim((string) $this->request->getGet('status'));
    $query        = trim((string) $this->request->getGet('q'));
    $dateRange    = trim((string) $this->request->getGet('date_range'));

    /*
    |--------------------------------------------------------------------------
    | Main Projects Query
    |--------------------------------------------------------------------------
    */
    $builder = $this->isspRecordModel
        ->select('
            issp_records.*,
            departments.name AS department_name,
            CONCAT(
                COALESCE(users.first_name, ""),
                " ",
                COALESCE(users.last_name, "")
            ) AS created_by_name
        ')
        ->join(
            'departments',
            'departments.id = issp_records.department_id',
            'left'
        )
        ->join(
            'users',
            'users.id = issp_records.created_by',
            'left'
        );

    /*
    |--------------------------------------------------------------------------
    | Status Filter
    |--------------------------------------------------------------------------
    */
    if ($statusFilter !== '') {
        $builder->where('issp_records.status', $statusFilter);
    }

    /*
    |--------------------------------------------------------------------------
    | Search Filter
    |--------------------------------------------------------------------------
    */
    if ($query !== '') {
        $builder->groupStart()
            ->like('issp_records.title', $query)
            ->orLike('issp_records.description', $query)
            ->orLike('departments.name', $query)
            ->orLike(
                'CONCAT(
                    COALESCE(users.first_name, ""),
                    " ",
                    COALESCE(users.last_name, "")
                )',
                $query,
                'both',
                true
            )
            ->groupEnd();
    }

    /*
    |--------------------------------------------------------------------------
    | Date Range Filter
    |--------------------------------------------------------------------------
    */
    if ($dateRange !== '') {

        $dates = preg_split('/\s+to\s+/i', $dateRange);

        if (
            is_array($dates) &&
            count($dates) === 2 &&
            preg_match('/^\d{4}-\d{2}-\d{2}$/', trim($dates[0])) &&
            preg_match('/^\d{4}-\d{2}-\d{2}$/', trim($dates[1]))
        ) {
            $startDate = trim($dates[0]);
            $endDate   = trim($dates[1]);

            $builder
                ->where(
                    'issp_records.updated_at >=',
                    $startDate . ' 00:00:00'
                )
                ->where(
                    'issp_records.updated_at <=',
                    $endDate . ' 23:59:59'
                );
        }
    }

    /*
    |--------------------------------------------------------------------------
    | Pagination
    |--------------------------------------------------------------------------
    */
$perPage = 10;

$projects = $builder
    ->orderBy('issp_records.id', 'DESC')
    ->paginate($perPage);

$pager = $this->isspRecordModel->pager;

$currentPage = (int) ($this->request->getGet('page') ?? 1);

$total = $pager->getTotal();

    /*
    |--------------------------------------------------------------------------
    | Status Counts
    |--------------------------------------------------------------------------
    */
    $statusCounts = [
        'pending'     => 0,
        'endorsed'    => 0,
        'approved'    => 0,
        'rejected'    => 0,
        'returned'    => 0,
        'resubmitted' => 0,
    ];

    $countBuilder = $this->isspRecordModel
        ->select('status, COUNT(*) AS total')
        ->groupBy('status')
        ->findAll();

    foreach ($countBuilder as $row) {

        $status = strtolower(trim((string) ($row['status'] ?? '')));
        $total  = (int) ($row['total'] ?? 0);

        if (isset($statusCounts[$status])) {
            $statusCounts[$status] = $total;
        }
    }

    /*
    |--------------------------------------------------------------------------
    | View
    |--------------------------------------------------------------------------
    */
    return view(
        'frontend/ict_planner/consolidation/index',
        [
            'projects'     => $projects,
            'title'        => 'ISSP Consolidation',
            'statusFilter' => $statusFilter,
            'query'        => $query,
            'date_range'   => $dateRange,
            'statusCounts' => $statusCounts,

              // Pagination
             'pager'        => $pager,
             'perPage'      => $perPage,
             'currentPage'  => $currentPage,
            'total'        => $total,
        ]
    );
}

    /**
     * ============================================================
     * VIEW FULL ISSP
     * ============================================================
     */
    public function viewFull(int $id)
    {
        $project = $this->loadProject($id);

        if (!$project) {
            throw \CodeIgniter\Exceptions\PageNotFoundException::forPageNotFound(
                'ISSP project not found.'
            );
        }

        $formData = $this->extractFormData($project);

        $resourceData = $this->loadResourceData($id);

       $agencyData = $this->loadAgencyData();

        return view(
            'frontend/ict_planner/consolidation/pdf_template',
            [
                'project'      => $project,
                'formData'     => $formData,
                'resourceData' => $resourceData,
                'agencyData'   => $agencyData,
                'batchMode'    => false,
            ]
        );
    }

    /**
     * ============================================================
     * LOAD PROJECT
     * ============================================================
     */
    protected function loadProject(int $id): ?array
    {
        $project = $this->isspRecordModel
            ->select('
                issp_records.*,
                departments.name AS department_name,
                CONCAT(
                    COALESCE(users.first_name, ""),
                    " ",
                    COALESCE(users.last_name, "")
                ) AS created_by_name
            ')
            ->join(
                'departments',
                'departments.id = issp_records.department_id',
                'left'
            )
            ->join(
                'users',
                'users.id = issp_records.created_by',
                'left'
            )
            ->where('issp_records.id', $id)
            ->first();

        return $project ?: null;
    }

    /**
     * ============================================================
     * EXTRACT FORM DATA
     * ============================================================
     */
    protected function extractFormData(array $project): array
    {
        $formData = [];

        if (!empty($project['form_data'])) {

            $decoded = json_decode(
                $project['form_data'],
                true
            );

            if (is_array($decoded)) {
                $formData = $decoded;
            }
        }

        return $formData;
    }

    /**
     * ============================================================
     * LOAD RESOURCE REQUIREMENTS
     *
     * IMPORTANT:
     * This is DB-driven.
     *
     * Year 1/2/3 are filtered using the ISSP record ID.
     * ============================================================
     */
    protected function loadResourceData(?int $isspRecordId = null): array
    {
        $model = $this->resourceRequirementModel;

        return [
            'year1' => $model->getByYear(
                1,
                $isspRecordId
            ),

            'year2' => $model->getByYear(
                2,
                $isspRecordId
            ),

            'year3' => $model->getByYear(
                3,
                $isspRecordId
            ),

            'generalSummary' => $model->getGeneralSummary(
                $isspRecordId
            ),

            'fundSource' => $model->getFundSourceSummary(
                $isspRecordId
            ),

            'statementOfExpenditure' =>
                $model->getStatementOfExpenditureSummary(
                    $isspRecordId
                ),

            'objectOfExpenditure' =>
                $model->getObjectOfExpenditureSummary(
                    $isspRecordId
                ),
        ];
    }

    /**
     * ============================================================
     * LOAD AGENCY DATA
     *
     * Agency information is tied to created_by.
     * ============================================================
     */
    protected function loadAgencyData(): array
{
    // Agency Information is maintained by the ICT Planner,
    // while the ISSP record itself may be created by an Employee.
    //
    // Therefore, do not use the ISSP record's created_by here.
    // Find the ICT Planner account dynamically.

    $ictPlanner = $this->agencyInformationModel
        ->db()
        ->table('users')
        ->select('users.id')
        ->where('users.role_id', 4)
        ->orderBy('users.id', 'DESC')
        ->get()
        ->getRowArray();

    if (empty($ictPlanner['id'])) {
        return [];
    }

    $record = $this->agencyInformationModel
        ->where('created_by', (int) $ictPlanner['id'])
        ->orderBy('id', 'DESC')
        ->first();

    return is_array($record)
        ? $record
        : [];
}
    /**
     * ============================================================
     * DOWNLOAD SINGLE PDF
     * ============================================================
     */
    public function download(int $id)
    {
        $project = $this->loadProject($id);

        if (!$project) {
            throw \CodeIgniter\Exceptions\PageNotFoundException::forPageNotFound(
                'ISSP project not found.'
            );
        }

        /*
         * Get all saved form data.
         */
        $formData = $this->extractFormData($project);

        /*
         * IMPORTANT:
         * Keep this.
         *
         * This loads Year 1, Year 2, Year 3 and all
         * resource summaries for THIS ISSP record.
         */
        $resourceData = $this->loadResourceData(
            (int) $id
        );

        /*
         * Load agency information belonging to
         * the user who created the ISSP.
         */
       $agencyData = $this->loadAgencyData();


        /*
         * PDF view data.
         */
        $viewData = [
            'project'      => $project,
            'formData'     => $formData,
            'resourceData' => $resourceData,
            'agencyData'   => $agencyData,
            'batchMode'    => false,
        ];

        /*
         * Render HTML.
         */
        $html = view(
            'frontend/ict_planner/consolidation/pdf_template',
            $viewData
        );

        /*
         * Dompdf configuration.
         */
        $options = new Options();

        $options->set(
            'isRemoteEnabled',
            true
        );

        $options->set(
            'isHtml5ParserEnabled',
            true
        );

        $options->set(
            'defaultFont',
            'DejaVu Sans'
        );

        $dompdf = new Dompdf($options);

        $dompdf->loadHtml($html);

        /*
         * PDF template is designed as LANDSCAPE.
         */
        $dompdf->setPaper(
            'A4',
            'landscape'
        );

        $dompdf->render();

        /*
         * Safe filename.
         */
        $title = trim(
            (string) (
                $project['title']
                ?? 'ISSP Submission'
            )
        );

        $filename = preg_replace(
            '/\s+/',
            '_',
            $title
        );

        $filename = preg_replace(
            '/[^A-Za-z0-9_\-]/',
            '',
            $filename
        );

        if (empty($filename)) {
            $filename = 'ISSP_Submission';
        }

        $filename .= '_' . $id . '.pdf';

        /*
         * Stream PDF.
         */
        $dompdf->stream(
            $filename,
            [
                'Attachment' => true,
            ]
        );

        exit;
    }

    /**
     * ============================================================
     * BATCH DOWNLOAD
     * ============================================================
     */
    public function batchDownload()
    {
        $projectIds = $this->request->getPost('project_ids');

        /*
         * Accept JSON array as well.
         */
        if (is_string($projectIds)) {

            $decoded = json_decode(
                $projectIds,
                true
            );

            if (is_array($decoded)) {
                $projectIds = $decoded;
            }
        }

        if (!is_array($projectIds)) {
            $projectIds = [];
        }

        /*
         * Clean IDs.
         */
        $projectIds = array_values(
            array_filter(
                array_map(
                    'intval',
                    $projectIds
                ),
                static function ($id) {
                    return $id > 0;
                }
            )
        );

        if (empty($projectIds)) {

            return $this->response
                ->setStatusCode(400)
                ->setJSON([
                    'success' => false,
                    'message' => 'No ISSP projects selected.',
                ]);
        }

        /*
         * Temporary PDF directory.
         */
        $tempDir = WRITEPATH . 'uploads/issp_batch';

        if (!is_dir($tempDir)) {

            mkdir(
                $tempDir,
                0775,
                true
            );
        }

        $pdfFiles = [];

        /*
         * ========================================================
         * IMPORTANT:
         * Each project gets its OWN:
         *
         * - project
         * - formData
         * - resourceData
         * - agencyData
         *
         * DO NOT load resourceData before this loop.
         * ========================================================
         */
        foreach ($projectIds as $id) {

            $project = $this->loadProject(
                (int) $id
            );

            if (!$project) {
                continue;
            }

            /*
             * Project-specific form data.
             */
            $formData = $this->extractFormData(
                $project
            );

            /*
             * Project-specific Resource Requirements.
             *
             * This is the line that MUST be inside
             * the foreach loop.
             */
            $resourceData = $this->loadResourceData(
                (int) $id
            );

            /*
